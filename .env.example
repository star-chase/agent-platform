# ============ 本地开发配置模板 ============
# 用法：cp .env.example .env，然后填上真实的 API Key。
# 这个文件会被提交进仓库，所以**只能放占位符**，永远不要写真实密钥。
#
# 容器部署用另一份：.env.docker.example（数据库地址从"文件"变成"服务名"）。

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 存储 ----
# 本地开发默认走 SQLite 文件，零外部服务（测试也是这么跑的）。
# 想用 PostgreSQL：注释掉下面两行不必要，只要设 DATABASE_URL，它优先。
DATABASE_PATH=agent.db
# DATABASE_URL=postgresql://agent:agent123@localhost:5432/agent_platform

# 本地要自己起一个 redis-server（4 个进程里唯一必需的外部依赖）
REDIS_URL=redis://localhost:6379/0

# ---- 编排 ----
ORCHESTRATOR_POLL_INTERVAL=2
STALE_TASK_MINUTES=15

# ---- 日志 ----
# 留空 = 只写 stdout。本地想 grep 文件就设成 agent.log。
LOG_PATH=
