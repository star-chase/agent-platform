# ============ 本地开发配置模板 ============
# 用法：cp .env.example .env，然后填上真实的 API Key。
# 这个文件会被提交进仓库，所以**只能放占位符**，永远不要写真实密钥。
#
# 容器部署用另一份：.env.docker.example（数据库地址从"文件"变成"服务名"）。

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 存储 ----
# 本地开发默认走 SQLite 文件，零外部服务（测试也是这么跑的）。
# 想用 PostgreSQL：注释掉下面两行不必要，只要设 DATABASE_URL，它优先。
DATABASE_PATH=agent.db
# DATABASE_URL=postgresql://agent:agent123@localhost:5432/agent_platform

# 本地要自己起一个 redis-server（4 个进程里唯一必需的外部依赖）
REDIS_URL=redis://localhost:6379/0

# ---- 编排 ----
ORCHESTRATOR_POLL_INTERVAL=2
STALE_TASK_MINUTES=15

# ---- MCP（可选）----
# 作为客户端：JSON 数组声明外部 MCP server（stdio），工具以 mcp__<server>__<tool> 注册。
# 留空 = 不接外部工具，默认行为完全不变。示例：
# MCP_SERVERS=[{"name":"rag","command":["python","-m","app.mcp.server"],"cwd":"/path/to/rag-agent","allowed_tools":["search_knowledge"]}]
# 作为服务端（python -m app.mcp.server）：工具薄适配本机 HTTP API，不复制业务逻辑。
# AGENT_PLATFORM_API=http://localhost:8000
# MCP_API_TIMEOUT=30
# 控制面工具（查/批审批）默认不挂载；能替人批准动作的能力不该默认打开。
# MCP_ALLOW_CONTROL=0

# ---- 日志 ----
# 留空 = 只写 stdout。本地想 grep 文件就设成 agent.log。
LOG_PATH=
