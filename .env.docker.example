# ============ 容器内配置（docker compose 用这一份）============
# 用法：cp .env.docker.example .env.docker，然后填上真实的 API Key。
#
# 和本地开发的区别只有两条：数据库地址从"文件"变成"服务名 + 端口"，
# Redis 同理。**代码一行都不用改** —— 这就是 8-0 那层适配层的兑现。

# ---- DeepSeek ----
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ---- 存储 ----
# ⚠️ 主机名是 compose 的**服务名** postgres，不是 localhost。
# 每个容器有自己的网络命名空间，localhost 指的是容器自己。
DATABASE_URL=postgresql://agent:agent123@postgres:5432/agent_platform
REDIS_URL=redis://redis:6379/0

# 想回退到 SQLite（做对照实验用）：注释掉 DATABASE_URL，
# 然后给 api/worker/orchestrator 挂一个卷，否则数据随容器消失。
# DATABASE_PATH=/data/agent.db

# ---- 宿主机端口映射（只为本地调试方便）----
# 容器之间走内部网络，用的是 5432/6379/8000，不受这三个值影响。
# 本机已经有 PG/Redis 占着默认端口时，改成别的就行。
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- 编排 ----
ORCHESTRATOR_POLL_INTERVAL=2
STALE_TASK_MINUTES=15

# ---- 日志 ----
# 留空 = 只写 stdout（容器里的标准做法，用 docker logs 看）。
# 设了路径就同时写文件，方便进容器 grep。
LOG_PATH=
