{"id": "plan-diamond", "category": "plan", "kind": "plan", "name": "菱形计划：节点、依赖、就绪顺序正确", "plan": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}, {"id": "C", "depends_on": ["A"]}, {"id": "D", "depends_on": ["B", "C"]}]}, "expect": {"ok": true, "nodes": ["A", "B", "C", "D"], "edges": [["A", "B"], ["A", "C"], ["B", "D"], ["C", "D"]], "sinks": ["D"], "ready_initial": ["A"], "ready_after": {"completed": ["A"], "ready": ["B", "C"]}}}
{"id": "plan-parallel-width", "category": "plan", "kind": "plan", "name": "一对多计划：单轮可派发 3 个并行分支", "plan": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}, {"id": "C", "depends_on": ["A"]}, {"id": "D", "depends_on": ["A"]}]}, "expect": {"ok": true, "sinks": ["B", "C", "D"], "ready_after": {"completed": ["A"], "ready": ["B", "C", "D"]}}}
{"id": "plan-chain", "category": "plan", "kind": "plan", "name": "链式计划：每轮只有一个就绪节点", "plan": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}, {"id": "C", "depends_on": ["B"]}]}, "expect": {"ok": true, "sinks": ["C"], "ready_initial": ["A"], "ready_after": {"completed": ["A"], "ready": ["B"]}}}
{"id": "plan-cycle", "category": "plan", "kind": "plan", "name": "环计划被拒绝（规划期拦截，不浪费执行）", "plan": {"nodes": [{"id": "A", "depends_on": ["B"]}, {"id": "B", "depends_on": ["A"]}]}, "expect": {"ok": false}}
{"id": "plan-unknown-dep", "category": "plan", "kind": "plan", "name": "引用不存在节点的计划被拒绝", "plan": {"nodes": [{"id": "write", "depends_on": ["missing"]}]}, "expect": {"ok": false}}
{"id": "plan-node-limit", "category": "plan", "kind": "plan", "name": "节点数超过上限的计划被拒绝", "plan": {"max_nodes": 2, "nodes": [{"id": "A"}, {"id": "B"}, {"id": "C"}]}, "expect": {"ok": false}}
{"id": "sched-linear-complete", "category": "schedule", "kind": "schedule", "name": "线性 DAG：全部节点完成后 workflow 终态 COMPLETED 且产出最终答案", "dag": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}]}, "script": {"A": ["COMPLETED"], "B": ["COMPLETED"]}, "expect": {"terminal": "COMPLETED", "attempts": {"A": 1, "B": 1}, "final_output_contains": "B-out"}}
{"id": "sched-parallel-dispatch", "category": "schedule", "kind": "schedule", "name": "菱形 DAG：中间两个分支在同一轮派发（并行宽度 2）", "dag": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}, {"id": "C", "depends_on": ["A"]}, {"id": "D", "depends_on": ["B", "C"]}]}, "script": {"A": ["COMPLETED"], "B": ["COMPLETED"], "C": ["COMPLETED"], "D": ["COMPLETED"]}, "expect": {"terminal": "COMPLETED", "max_dispatch_width": 2, "attempts": {"A": 1, "B": 1, "C": 1, "D": 1}}}
{"id": "sched-upstream-output-in-question", "category": "schedule", "kind": "schedule", "name": "下游节点的 question 注入直接上游产出", "dag": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}]}, "script": {"A": ["COMPLETED"], "B": ["COMPLETED"]}, "upstream_node": "B", "probe": "A-out-0", "expect": {"terminal": "COMPLETED", "upstream_in_question": true}}
{"id": "sched-retry-success", "category": "schedule", "kind": "schedule", "name": "节点失败后重试成功：workflow 仍判 COMPLETED（最新一次尝试说了算）", "dag": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}]}, "script": {"A": ["COMPLETED"], "B": ["FAILED", "COMPLETED"]}, "expect": {"terminal": "COMPLETED", "attempts": {"A": 1, "B": 2}, "task_status": {"A": "COMPLETED", "B": "COMPLETED"}}}
{"id": "sched-retry-exhausted", "category": "schedule", "kind": "schedule", "name": "节点重试额度用尽：workflow 判 FAILED，尝试次数卡在上限", "dag": {"nodes": [{"id": "A"}, {"id": "B", "depends_on": ["A"]}]}, "script": {"A": ["COMPLETED"], "B": ["FAILED", "FAILED", "FAILED"]}, "max_node_attempts": 3, "expect": {"terminal": "FAILED", "attempts": {"A": 1, "B": 3}}}
{"id": "sched-budget-fatal-no-retry", "category": "schedule", "kind": "schedule", "name": "预算超支是确定性失败：整个 workflow FAILED 且不重试", "dag": {"nodes": [{"id": "A"}]}, "script": {"A": ["BUDGET_EXCEEDED"]}, "expect": {"terminal": "FAILED", "attempts": {"A": 1}, "task_status": {"A": "BUDGET_EXCEEDED"}}}
{"id": "sched-approval-approved", "category": "schedule", "kind": "schedule", "name": "审批门控：节点先挂起等批准，批准后才入队并完成", "dag": {"nodes": [{"id": "A", "requires_approval": true}]}, "approvals": {"A": "approve"}, "script": {"A": ["COMPLETED"]}, "expect": {"terminal": "COMPLETED", "waited_for_approval": true, "attempts": {"A": 1}}}
{"id": "sched-approval-rejected", "category": "schedule", "kind": "schedule", "name": "审批被拒绝：节点 CANCELLED 且 workflow 判 FAILED（人类否决不走重试）", "dag": {"nodes": [{"id": "A", "requires_approval": true}]}, "approvals": {"A": "reject"}, "script": {}, "expect": {"workflow_status": "FAILED", "task_status": {"A": "CANCELLED"}}}
{"id": "sched-stuck-node-not-terminal", "category": "schedule", "kind": "schedule", "name": "worker 卡死：调度器不会自行判死（靠 STALE_TASK_MINUTES 回收）", "dag": {"nodes": [{"id": "A"}]}, "script": {}, "expect": {"terminal": "WAITING", "attempts": {"A": 1}}}
{"id": "gov-idempotent-step", "category": "governance", "kind": "governance", "name": "同一步骤重复写入被唯一约束拒绝（幂等）", "check": "idempotent_step", "expect": {"duplicate_rejected": true}}
{"id": "gov-no-progress-triggered", "category": "governance", "kind": "governance", "name": "连续两轮没有新信息（第 3 次相同结果）：无进展检测触发强制收尾", "check": "no_progress", "rounds": 2, "rounds_observations": [["same"], ["same"], ["same"]], "expect": {"final_triggered": true}}
{"id": "gov-progress-new-info-continues", "category": "governance", "kind": "governance", "name": "出现新信息时不误判为无进展", "check": "no_progress", "rounds": 2, "rounds_observations": [["same"], ["same"], ["different"]], "expect": {"final_triggered": false}}
{"id": "gov-terminal-no-retry", "category": "governance", "kind": "governance", "name": "终态 BUDGET_EXCEEDED 没有出边：不可能被改回 RUNNING", "check": "terminal_transition", "from_status": "BUDGET_EXCEEDED", "to_status": "RUNNING", "expect": {"raised": true, "status": "BUDGET_EXCEEDED"}}
{"id": "gov-cancel-task", "category": "governance", "kind": "governance", "name": "取消 PENDING 任务：状态变为 CANCELLED", "check": "cancel_task", "expect": {"status": "CANCELLED", "task_status": "CANCELLED"}}
{"id": "cost-budget-boundary", "category": "cost", "kind": "cost", "name": "预算闸门边界：用满即停、无上限永不拦", "check": "budget_boundary", "cases": [{"spent": 0.05, "budget": 0.05}, {"spent": 0.04, "budget": 0.05}, {"spent": 999.0, "budget": null}], "expect": {"exceeded": [true, false, false]}}
{"id": "cost-estimate-monotonic", "category": "cost", "kind": "cost", "name": "成本估算随 token 增长而单调增长", "check": "estimate_monotonic", "input_tokens": 1000, "output_tokens": 500, "expect": {"monotonic": true}}
{"id": "cost-workflow-aggregation", "category": "cost", "kind": "cost", "name": "workflow 成本按所有子任务汇总（JOIN tasks）", "check": "workflow_cost", "tokens": {"a": [1000, 500], "b": [200, 100]}, "expect": {"input_tokens": 1200, "output_tokens": 600}}
{"id": "trace-attempts-and-missing", "category": "cost", "kind": "cost", "name": "trace 能组装尝试记录，未知 workflow 返回 None", "check": "trace_attempts", "expect": {"attempts": 1, "has_critical_path": true, "missing_workflow_none": true}}
